#!/usr/bin/env bash
# Claude Code status line: model name and context window use.
# In ~/.claude/settings.json:
#   "statusLine": { "type": "command", "command": "~/.dotfiles/bin/claude-statusline" }
input=$(cat)
model=$(jq -r '.model.display_name // empty' <<<"$input")
used=$(jq -r '.context_window.used_percentage // empty' <<<"$input")
if [[ -n $used ]]; then
  printf '%s | ctx: %.0f%% used' "$model" "$used"
else
  printf '%s' "$model"
fi
