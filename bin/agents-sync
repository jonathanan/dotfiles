#!/usr/bin/env bash
# Combine global agent instructions for each harness.
#   Public:  $DOTFILES/agents/AGENTS.md
#   Local:   ~/.agents-local/*.md (optional, machine or employer specific, not in this repo)
# Also refreshes the herdr skill and links Claude Code skills for Codex.
# --quiet prints nothing. zsh/zshrc runs it that way when skills or herdr change.
set -euo pipefail

quiet=false
[[ ${1:-} == --quiet ]] && quiet=true
say() { $quiet || echo "$@"; }

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
public="$DOTFILES/agents/AGENTS.md"
local_dir="$HOME/.agents-local"

# Codex: no import syntax, so write a generated file.
if [[ -d $HOME/.codex ]]; then
  out="$HOME/.codex/AGENTS.md"
  if [[ -f $out ]] && ! grep -q '^<!-- generated by agents-sync' "$out"; then
    say ">> Skip: $out exists and was not generated by agents-sync"
  else
    {
      echo "<!-- generated by agents-sync from $public and $local_dir/*.md. Do not edit. -->"
      cat "$public"
      for f in "$local_dir"/*.md; do
        [[ -e $f ]] || continue
        echo
        cat "$f"
      done
    } >"$out"
    say ">> Wrote: $out"
  fi
fi

# Claude Code: CLAUDE.md supports @path imports, so write a stub once.
if [[ -d $HOME/.claude ]]; then
  out="$HOME/.claude/CLAUDE.md"
  if [[ -e $out ]]; then
    grep -qF "@$public" "$out" || say ">> Skip: $out exists. Add this line to use the shared file: @$public"
  else
    {
      echo "@$public"
      for f in "$local_dir"/*.md; do
        [[ -e $f ]] && echo "@$f"
      done
    } >"$out"
    say ">> Wrote: $out"
  fi
fi

# herdr skill: the herdr binary prints its own skill (`herdr --skill`), so the copy
# always matches the installed version. Refresh it for each harness that is present.
herdr_bin=$(command -v herdr || true)
for candidate in "$HOME/.local/share/mise/installs/herdr/latest/herdr" "$HOME/.local/share/mise/shims/herdr"; do
  [[ -z $herdr_bin && -x $candidate ]] && herdr_bin=$candidate
done
if [[ -n $herdr_bin ]] && skill=$("$herdr_bin" --skill 2>/dev/null) && [[ $skill == ---* ]]; then
  for dir in "$HOME/.claude" "$HOME/.kiro" "$HOME/.codex"; do
    [[ -d $dir ]] || continue
    out="$dir/skills/herdr/SKILL.md"
    if [[ -f $out ]] && [[ "$(cat "$out")" == "$skill" ]]; then
      say ">> Ok: $out"
    else
      mkdir -p "$(dirname "$out")"
      printf '%s\n' "$skill" >"$out"
      say ">> Wrote: $out"
    fi
  done
else
  say ">> Skip: herdr skill (herdr not found)"
fi

# Codex skills: link each Claude Code skill into ~/.agents/skills, which Codex reads.
# Links follow updates to the skill in place. Skills that use Claude-only features are
# skipped. Override with one skill name per line in ~/.agents-local/codex-skip or
# ~/.agents-local/codex-allow.
src="$HOME/.claude/skills"
dst="$HOME/.agents/skills"
listed() { [[ -f $local_dir/$1 ]] && grep -qxF "$2" "$local_dir/$1"; }
claude_only() {
  local dir=$1 keys refs
  keys=$(awk '/^---$/{n++; next} n==1' "$dir/SKILL.md" | grep -oE '^[A-Za-z_-]+:' | tr -d : |
    grep -vxE 'name|description|license|compatibility|metadata' | tr '\n' ' ' || true)
  if [[ -n $keys ]]; then echo "frontmatter: ${keys% }"; return; fi
  refs=$(grep -rhoIE 'mcp__[A-Za-z0-9_-]+__|\b(TodoWrite|WebFetch|AskUserQuestion)\b|Task tool|\$ARGUMENTS|\bCLAUDE_[A-Z_]+' "$dir/" 2>/dev/null |
    sort -u | head -3 | tr '\n' ' ' || true)
  [[ -z $refs ]] || echo "uses: ${refs% }"
}
if [[ -d $HOME/.codex && -d $src ]]; then
  mkdir -p "$dst"
  for dir in "$src"/*/; do
    dir=${dir%/}; name=${dir##*/}; link="$dst/$name"
    [[ -f $dir/SKILL.md ]] || continue
    if [[ -e $HOME/.codex/skills/$name ]]; then
      reason="already in ~/.codex/skills"
    elif listed codex-skip "$name"; then
      reason="listed in codex-skip"
    elif listed codex-allow "$name"; then
      reason=""
    else
      reason=$(claude_only "$dir")
    fi
    if [[ -L $link && $(readlink "$link") == "$dir" ]]; then
      if [[ -n $reason ]]; then rm "$link"; say ">> Unlinked: $name ($reason)"; fi
    elif [[ -e $link || -L $link ]]; then
      say ">> Skip: $link exists and was not linked by agents-sync"
    elif [[ -n $reason ]]; then
      say ">> Skip: $name ($reason)"
    else
      ln -s "$dir" "$link"; say ">> Linked: $link"
    fi
  done
  # Remove links whose skill was uninstalled.
  for link in "$dst"/*; do
    [[ -L $link && ! -e $link && $(readlink "$link") == "$src"/* ]] || continue
    rm "$link"; say ">> Removed: $link (skill no longer installed)"
  done
fi

stamp="${XDG_STATE_HOME:-$HOME/.local/state}/agents-sync.stamp"
mkdir -p "$(dirname "$stamp")" && touch "$stamp"
