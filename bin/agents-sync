#!/usr/bin/env bash
# Combine global agent instructions for each harness.
#   Public:  $DOTFILES/agents/AGENTS.md
#   Local:   ~/.agents-local/*.md (optional, machine or employer specific, not in this repo)
# Writes ~/.codex/AGENTS.md and ~/.kiro/steering/agents.md.
# Also refreshes the herdr, hc and herdr-app skills and links Claude Code skills for Codex.
# --quiet prints nothing. zsh/zshrc runs it that way when skills or herdr change.
set -euo pipefail

quiet=false
[[ ${1:-} == --quiet ]] && quiet=true
say() { $quiet || echo "$@"; }

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
public="$DOTFILES/agents/AGENTS.md"
local_dir="$HOME/.agents-local"

# Codex: no import syntax, so write a generated file.
write_combined() {
  local out=$1
  if [[ -f $out ]] && ! grep -q '^<!-- generated by agents-sync' "$out"; then
    say ">> Skip: $out exists and was not generated by agents-sync"
    return
  fi
  {
    echo "<!-- generated by agents-sync from $public and $local_dir/*.md. Do not edit. -->"
    cat "$public"
    for f in "$local_dir"/*.md; do
      [[ -e $f ]] || continue
      echo
      cat "$f"
    done
  } >"$out"
  say ">> Wrote: $out"
}
[[ -d $HOME/.codex ]] && write_combined "$HOME/.codex/AGENTS.md"

# Kiro: steering files load from ~/.kiro/steering. Write the public rules only, because
# local rules for Kiro go straight into ~/.kiro/steering. Front matter must come first.
if [[ -d $HOME/.kiro ]]; then
  out="$HOME/.kiro/steering/agents.md"
  if [[ -f $out ]] && ! grep -q '^<!-- generated by agents-sync' "$out"; then
    say ">> Skip: $out exists and was not generated by agents-sync"
  else
    mkdir -p "$(dirname "$out")"
    {
      printf -- '---\ninclusion: always\n---\n'
      echo "<!-- generated by agents-sync from $public. Do not edit. -->"
      cat "$public"
    } >"$out"
    say ">> Wrote: $out"
  fi
fi

# Claude Code: CLAUDE.md supports @path imports, so write a stub once.
if [[ -d $HOME/.claude ]]; then
  out="$HOME/.claude/CLAUDE.md"
  if [[ -e $out ]]; then
    grep -qF "@$public" "$out" || say ">> Skip: $out exists. Add this line to use the shared file: @$public"
  else
    {
      echo "@$public"
      for f in "$local_dir"/*.md; do
        [[ -e $f ]] && echo "@$f"
      done
    } >"$out"
    say ">> Wrote: $out"
  fi
fi

# Tool skills: herdr, hc (herdr-core) and herdr-app print their own manual (`<tool> --skill`),
# so the copy always matches the installed version. Refresh it for each harness that is
# present. A manual without frontmatter gets one, so harnesses can list it.
write_skill() { # <skill-name> <content>
  local dir out
  for dir in "$HOME/.claude" "$HOME/.kiro" "$HOME/.codex"; do
    [[ -d $dir ]] || continue
    out="$dir/skills/$1/SKILL.md"
    if [[ -f $out ]] && [[ "$(cat "$out")" == "$2" ]]; then
      say ">> Ok: $out"
    else
      mkdir -p "$(dirname "$out")"
      printf '%s\n' "$2" >"$out"
      say ">> Wrote: $out"
    fi
  done
}
sync_tool_skill() { # <skill-name> <description> <binary candidates...>
  local name=$1 desc=$2 bin= c skill
  shift 2
  for c in "$@"; do
    [[ -z $bin && -n $c && -x $c ]] && bin=$c
  done
  if [[ -z $bin ]] || ! skill=$("$bin" --skill 2>/dev/null) || [[ -z $skill ]]; then
    say ">> Skip: $name skill ($name not found)"
    return
  fi
  [[ $skill == ---* ]] || skill=$(printf -- '---\nname: %s\ndescription: %s\n---\n\n%s' "$name" "$desc" "$skill")
  write_skill "$name" "$skill"
}
sync_tool_skill herdr "Drive the herdr terminal multiplexer." \
  "$(command -v herdr || true)" "$HOME/.local/share/mise/installs/herdr/latest/herdr" \
  "$HOME/.local/share/mise/shims/herdr"
sync_tool_skill hc "Manual for hc (herdr-core): run programs and agents in persistent terminals, delegate to child agents, send, read and wait. Use when HC_TERMINAL_ID is set or the user mentions hc or herdr-core." \
  "$(command -v hc || true)" "$HOME/.local/bin/hc"
sync_tool_skill herdr-app "Manual for herdr-app (Herdr.app): spaces, tabs, layouts, keys and mods. Use when the user mentions herdr-app or Herdr.app." \
  "$(command -v herdr-app || true)" "$HOME/.local/bin/herdr-app"

# Codex skills: link each Claude Code skill into ~/.agents/skills, which Codex reads.
# Links follow updates to the skill in place. Skills that use Claude-only features are
# skipped. Override with one skill name per line in ~/.agents-local/codex-skip or
# ~/.agents-local/codex-allow.
src="$HOME/.claude/skills"
dst="$HOME/.agents/skills"
listed() { [[ -f $local_dir/$1 ]] && grep -qxF "$2" "$local_dir/$1"; }
claude_only() {
  local dir=$1 keys refs
  keys=$(awk '/^---$/{n++; next} n==1' "$dir/SKILL.md" | grep -oE '^[A-Za-z_-]+:' | tr -d : |
    grep -vxE 'name|description|license|compatibility|metadata' | tr '\n' ' ' || true)
  if [[ -n $keys ]]; then echo "frontmatter: ${keys% }"; return; fi
  refs=$(grep -rhoIE 'mcp__[A-Za-z0-9_-]+__|\b(TodoWrite|WebFetch|AskUserQuestion)\b|Task tool|\$ARGUMENTS|\bCLAUDE_[A-Z_]+' "$dir/" 2>/dev/null |
    sort -u | head -3 | tr '\n' ' ' || true)
  [[ -z $refs ]] || echo "uses: ${refs% }"
}
if [[ -d $HOME/.codex && -d $src ]]; then
  mkdir -p "$dst"
  for dir in "$src"/*/; do
    dir=${dir%/}; name=${dir##*/}; link="$dst/$name"
    [[ -f $dir/SKILL.md ]] || continue
    if [[ -e $HOME/.codex/skills/$name ]]; then
      reason="already in ~/.codex/skills"
    elif listed codex-skip "$name"; then
      reason="listed in codex-skip"
    elif listed codex-allow "$name"; then
      reason=""
    else
      reason=$(claude_only "$dir")
    fi
    if [[ -L $link && $(readlink "$link") == "$dir" ]]; then
      if [[ -n $reason ]]; then rm "$link"; say ">> Unlinked: $name ($reason)"; fi
    elif [[ -e $link || -L $link ]]; then
      say ">> Skip: $link exists and was not linked by agents-sync"
    elif [[ -n $reason ]]; then
      say ">> Skip: $name ($reason)"
    else
      ln -s "$dir" "$link"; say ">> Linked: $link"
    fi
  done
  # Remove links whose skill was uninstalled.
  for link in "$dst"/*; do
    [[ -L $link && ! -e $link && $(readlink "$link") == "$src"/* ]] || continue
    rm "$link"; say ">> Removed: $link (skill no longer installed)"
  done
fi

stamp="${XDG_STATE_HOME:-$HOME/.local/state}/agents-sync.stamp"
mkdir -p "$(dirname "$stamp")" && touch "$stamp"
