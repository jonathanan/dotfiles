#!/usr/bin/env bash
# Combine global agent instructions for each harness.
#   Public:  $DOTFILES/agents/AGENTS.md
#   Local:   ~/.agents-local/*.md (optional, machine or employer specific, not in this repo)
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
public="$DOTFILES/agents/AGENTS.md"
local_dir="$HOME/.agents-local"

# Codex: no import syntax, so write a generated file.
if [[ -d $HOME/.codex ]]; then
  out="$HOME/.codex/AGENTS.md"
  if [[ -f $out ]] && ! grep -q '^<!-- generated by agents-sync' "$out"; then
    echo ">> Skip: $out exists and was not generated by agents-sync"
  else
    {
      echo "<!-- generated by agents-sync from $public and $local_dir/*.md. Do not edit. -->"
      cat "$public"
      for f in "$local_dir"/*.md; do
        [[ -e $f ]] || continue
        echo
        cat "$f"
      done
    } >"$out"
    echo ">> Wrote: $out"
  fi
fi

# Claude Code: CLAUDE.md supports @path imports, so write a stub once.
if [[ -d $HOME/.claude ]]; then
  out="$HOME/.claude/CLAUDE.md"
  if [[ -e $out ]]; then
    grep -qF "@$public" "$out" || echo ">> Skip: $out exists. Add this line to use the shared file: @$public"
  else
    {
      echo "@$public"
      for f in "$local_dir"/*.md; do
        [[ -e $f ]] && echo "@$f"
      done
    } >"$out"
    echo ">> Wrote: $out"
  fi
fi

# herdr skill: the herdr binary prints its own skill (`herdr --skill`), so the copy
# always matches the installed version. Refresh it for each harness that is present.
herdr_bin=$(command -v herdr || true)
for candidate in "$HOME/.local/share/mise/installs/herdr/latest/herdr" "$HOME/.local/share/mise/shims/herdr"; do
  [[ -z $herdr_bin && -x $candidate ]] && herdr_bin=$candidate
done
if [[ -n $herdr_bin ]] && skill=$("$herdr_bin" --skill 2>/dev/null) && [[ $skill == ---* ]]; then
  for dir in "$HOME/.claude" "$HOME/.kiro" "$HOME/.codex"; do
    [[ -d $dir ]] || continue
    out="$dir/skills/herdr/SKILL.md"
    if [[ -f $out ]] && [[ "$(cat "$out")" == "$skill" ]]; then
      echo ">> Ok: $out"
    else
      mkdir -p "$(dirname "$out")"
      printf '%s\n' "$skill" >"$out"
      echo ">> Wrote: $out"
    fi
  done
else
  echo ">> Skip: herdr skill (herdr not found)"
fi
