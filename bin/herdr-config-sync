#!/usr/bin/env bash
# Write ~/.config/herdr/config.toml from the shared config in this repo plus an optional
# machine-specific ~/.config/herdr/config.local.toml. herdr reads one file and has no
# include setting, so the two parts are combined here.
set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
dir="${XDG_CONFIG_HOME:-$HOME/.config}/herdr"
base="$DOTFILES/herdr/config.toml"
local_file="$dir/config.local.toml"
out="$dir/config.toml"

mkdir -p "$dir"
# Replace an old symlink into this repo, and keep a copy of a hand-edited file.
if [[ -L $out ]]; then
  rm "$out"
elif [[ -f $out ]] && ! grep -q '^# generated by herdr-config-sync' "$out"; then
  mv "$out" "$out.bak.$(date +%Y%m%d%H%M%S)"
  echo ">> Backed up hand-edited $out"
fi

tmp=$(mktemp "$dir/.config.toml.XXXXXX")
{
  echo "# generated by herdr-config-sync. Do not edit. Edit $base"
  echo "# or $local_file, then run herdr-config-sync."
  echo
  cat "$base"
  if [[ -f $local_file ]]; then
    echo
    cat "$local_file"
  fi
} >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$out"
echo ">> Wrote: $out"

# Reload a running server. No server running (for example on a thin client) is fine.
if command -v herdr >/dev/null 2>&1; then
  if herdr server reload-config >/dev/null 2>&1; then
    echo ">> Reloaded the running herdr server"
  else
    echo ">> No local herdr server reloaded. It reads the new config when it starts."
  fi
fi
