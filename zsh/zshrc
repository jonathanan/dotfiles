# Shared zsh config. The local ~/.zshrc stub sources this file.
# Machine-specific config goes in ~/.zshrc.local or in the stub itself.

export DOTFILES="${${(%):-%x}:A:h:h}"

if (( $+commands[nvim] )); then
  export EDITOR=nvim
else
  export EDITOR=vim
fi
export KEYTIMEOUT=1 # Reduce time to switch between insert/cmd mode

source "$DOTFILES/zsh/plugins.zsh"
source "$DOTFILES/zsh/key-bindings.zsh"
source "$DOTFILES/zsh/aliases.zsh"
source "$DOTFILES/zsh/config.zsh"

autoload -Uz promptinit && promptinit && prompt pure

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# Rerun agents-sync in the background when a skill is added or removed, or herdr changes.
() {
  local stamp=${XDG_STATE_HOME:-$HOME/.local/state}/agents-sync.stamp
  local herdr_bin=${commands[herdr]:A}
  if [[ ! -e $stamp || $HOME/.claude/skills -nt $stamp || ( -n $herdr_bin && $herdr_bin -nt $stamp ) ]]; then
    ("$DOTFILES/bin/agents-sync" --quiet >/dev/null 2>&1 &)
  fi
}

if [[ -r $HOME/.zshrc.local ]]; then
  source "$HOME/.zshrc.local"
fi
